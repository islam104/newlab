# Database
DB_URL=jdbc:postgresql://localhost:5432/newsem_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT (Base64-encoded secrets, 32+ bytes)
JWT_ACCESS_SECRET=wrz9XyUgLd+fcAEU+E4yjjdg9ec+icxPJ4B/IUnoViI=
JWT_REFRESH_SECRET=U+/ajsL24zZRHCaUUv8ZZ1S21VHXzKjIff8uXG5w1Os=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Ticket signature (RSA keystore + certificate)
SIGNATURE_KEYSTORE_PATH=./.secrets/signature/ticket-signing.p12
SIGNATURE_KEYSTORE_TYPE=PKCS12
SIGNATURE_KEYSTORE_PASSWORD=change_me
SIGNATURE_KEY_ALIAS=ticket-signing
SIGNATURE_KEY_PASSWORD=change_me
SIGNATURE_ALGORITHM=SHA256withRSA
# Base64 from the exported X.509 certificate (public key for verification)
SIGNATURE_PUBLIC_CERT_BASE64=
TICKET_TTL_SECONDS=300

# TLS/HTTPS
TLS_KEYSTORE_PATH=./.secrets/tls/server-keystore.p12
TLS_KEYSTORE_PASSWORD=change_me
TLS_KEY_ALIAS=service-tls
TLS_PORT=8443
